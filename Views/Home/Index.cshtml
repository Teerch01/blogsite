@model blogsite.Models.IndexViewModel

@{
    ViewData["Title"] = "Home Page";
}
<div class="main-index">
    <div class="container tag">
        @foreach (var tag in Model.Tags)
        {
            <a href="?tag=@tag" class="btn" id="tag">@tag</a>
        }
    </div>
    <div class="container index d-flex flex-column justify-content-center align-items-center">
        @if (string.IsNullOrEmpty(Context.Request.Query["tag"]))
        {
            <div class="title">
                <h1>Welcome to My Simple Blog</h1>
                <p>Check out our latest posts below:</p>
            </div>
        }

        @if (Model != null)
        {
            @foreach (var item in Model.Posts.OrderByDescending(x => x.CreatedOn).Take(4))
            {
                <form asp-action="ViewPost" asp-controller="Post" asp-route-itemid="@item.Id" class="card-index">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button class="card-index-body d-flex flex-row">
                        <div class="content">
                            <h5 class="card-title">@Html.DisplayFor(modelItem => item.Title)</h5>
                            <small style="margin: 0; font-size: 13px;">Posted on @item.CreatedOn.ToString("MMMM dd, yyyy")</small>
                        </div>
                        <img src="@item.ImageUrl" alt="img">
                    </button>
                </form>
            }
        }
    </div>
</div>