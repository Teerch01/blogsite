@model IEnumerable<blogsite.Models.DTO.ResponseDTO.PostResponseDTO>

@{
    ViewData["Title"] = "Home Page";
}

@* <style>
    .content-preview p br {
    display: -webkit-box;
    -webkit-line-clamp: 2; 
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style> *@

<div class="container d-flex flex-column justify-content-center align-items-center">
    <h1 class="display-4 text-center" style="color: white">Welcome to My Simple Blog</h1>
    <p class="text-center" style="color: white">Check out our latest posts below:</p>
    @if (Model != null)
    {
        @foreach (var item in Model.Where(x => (DateTime.UtcNow - x.CreatedOn ) < (TimeSpan.FromDays(4))))
        {
            <div class="card" style="flex: 0 0 30%; margin: 10px; width: 550px;">
                <div class="card-body d-flex flex-row" style="padding: 10px; justify-content: space-between;">
                    <div style="width: 100%; margin-right: 1rem; display: flex; flex-direction: column; align-items: start; justify-content: space-between;">
                        <h5 class="card-title" style="margin: 0;">@Html.DisplayFor(modelItem => item.Title)</h5>
                        <p>
                            @{
                                if (item.Content.Length > 100)
                                {
                                    var trimmedContent = item.Content.Substring(0, 100) + "...";
                                    @Html.Raw(trimmedContent);
                                }
                                else {
                                    @Html.Raw(item.Content);
                                }
                            }
                        </p>
                        <div style="display: flex; justify-content: space-between; width: 100%;">
                            <form asp-action="ViewPost" asp-controller="Post" asp-route-itemid="@item.Id">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button  type="submit" style="background: none; border: none; padding: 0; font-size:13px">
                                    Read more
                                </button>
                            </form>
                            <small style="margin: 0; font-size: 13px;">Posted on @item.CreatedOn.ToString("MMMM dd, yyyy")</small>
                        </div>
                    </div>
                    <img style="width:150px; height: 100px;"src="images/pexels-thisisengineering-3913025.jpg" alt="img">     
                </div>
            </div>
        }
    }
</div>