@model blogsite.Models.DTO.RequestDTO.PostRequestDTO

@{
    ViewData["Title"] = "CreatePost";
}

<link rel="stylesheet" href="/richtexteditor/rte_theme_default.css" />
<script type="text/javascript" src="/richtexteditor/rte.js"></script>
<script type="text/javascript" src='/richtexteditor/plugins/all_plugins.js'></script>

<div class="card createpost">
    <h2 class="text-center card-title">Create Blog</h2>
    <div class="card-body justify-content-center align-items-center">
        <form asp-action="CreatePost" enctype="multipart/form-data">
            @if (ViewBag.Message != null)
            {
                <div class="form-group" style="color: green;">@ViewBag.Message</div>
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Tag" class="control-label"></label>
                <input id="tag" asp-for="Tag" class="form-control" />
                <span asp-validation-for="Tag" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input id="titlename" asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div>
                <input name="Content" id="input" asp-for="Content" type="hidden" />
                <textarea asp-for="Content" id="div_editor1"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="form-group p-sm-1">
                <label asp-for="ImageFile" class="control-label imagefile"></label>
                <input type="file" asp-for="ImageFile" class="form-control" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
            <div class="form-group p-sm-2 text-center" id="btn">
                <a class="btn btn-primary btn-sm cancel" type="button" asp-controller="Login" asp-action="UserAccount">
                    Cancel
                </a>
                <input type="submit" value="Create" class="btn btn-primary btn-sm" />
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
