@model IEnumerable<blogsite.Models.DTO.ResponseDTO.PostResponseDTO>

@{
    ViewData["Title"] = "UserPosts";
}

<div class="container" style="display: flex; flex-direction: column; align-items: center;justify-content: center;">
    <a class="btn btn-primary m-2" style="width: 100px; position: relative; right: -185px;" type="button"
        asp-action="CreatePost">
        New Blog
    </a>
    <div class="d-flex justify-content-center align-items-center">
        <div class="col-12 col-md-10 col-lg-8 w-100">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Created On</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                                    <td>@item.CreatedOn.ToString("MMMM dd, yyyy")</td>
                                    <td>
                                        <form asp-action="ViewPost" asp-controller="Post" asp-route-itemid="@item.Id">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn">
                                                View
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
</div>