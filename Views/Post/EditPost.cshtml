@model blogsite.Models.DTO.ResponseDTO.PostResponseDTO

@{
    ViewData["Title"] = "EditPost";
}

<link rel="stylesheet" href="/richtexteditor/rte_theme_default.css" />
<script type="text/javascript" src="/richtexteditor/rte.js"></script>
<script type="text/javascript" src='/richtexteditor/plugins/all_plugins.js'></script>

<div class="card" style="width:859px">
    <h2 class="text-center card-title">Edit Blog</h2>
    <div class="card-body text-center justify-content-center align-items-center">
        <form asp-action="EditPost" enctype="multipart/form-data">
            @if (ViewBag.Message != null)
            {
                <div class="form-group" style="color: green;">@ViewBag.Message</div>
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" type="hidden" value="@Model.Id" />
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" value="@Model.Title">
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div>
                <input name="Content" id="input" asp-for="Content" type="hidden" />
                <textarea asp-for="Content" id="div_editor1"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div class="form-group p-sm-1">
                <label asp-for="ImageUrl" class="control-label"></label>
                <input type="file" asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
            <div class="form-group p-sm-2">
                <input type="submit" value="Confirm" class="btn btn-primary btn-sm" />
            </div>
            <div>
                <a class="btn btn-primary btn-sm" type="button" asp-controller="Login" asp-action="UserAccount">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}