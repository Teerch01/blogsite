@model IEnumerable<blogsite.Models.DTO.ResponseDTO.PostResponseDTO>

@{
    ViewData["Title"] = "UserAccount";
}

<div class="useraccount">
    <div class="container">
        <h1 class="text-center">Blogs</h1>
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <form asp-action="ViewPost" asp-controller="Post" asp-route-itemid="@item.Id" class="card-index">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button class="card-index-body d-flex flex-row">
                        <div class="content">
                            <h5 class="card-title">@Html.DisplayFor(modelItem => item.Title)</h5>
                            <small>Posted on @item.CreatedOn.ToString("MMMM dd, yyyy")</small>
                        </div>
                        <img src="@item.ImageUrl" alt="img">
                    </button>
                </form>
            }
        }
    </div>
</div>
